type ObservationService struct{ repo repository.ObservationStore }

func NewObservationService(repo repository.ObservationStore) *ObservationService {
	return &ObservationService{repo: repo}
}

func (s *ObservationService) CreateObservation(ctx context.Context, o internal.Observation) (internal.Observation, error) {
	if err := o.Validate(); err != nil {
		return internal.Observation{}, err
	}
	o.ID = "obs-" + rand.Text()
	o.Meta = internal.Meta{VersionID: "1", LastUpdated: time.Now().UTC().Format(time.RFC3339Nano)}
	data, err := json.Marshal(o)
	if err != nil {
		return internal.Observation{}, err
	}
	if err := s.repo.SaveObservation(ctx, o, data); err != nil {
		return internal.Observation{}, err
	}
	return o, nil
}

func (s *ObservationService) GetObservationsForPatient(ctx context.Context, patient string) (internal.Bundle, error) {
	id, err := internal.PatientSearchID(patient)
	if err != nil {
		return internal.Bundle{}, err
	}
	data, err := s.repo.GetObservationsByPatient(ctx, id)
	if err != nil {
		return internal.Bundle{}, err
	}

	total := len(data)
	bundle := internal.Bundle{ResourceType: "Bundle", Type: "searchset", Total: &total}
	for _, storedData := range data {
		var decoded *internal.Observation
		decoder := json.NewDecoder(bytes.NewReader(storedData))
		decoder.DisallowUnknownFields()
		if err := decoder.Decode(&decoded); err != nil {
			return internal.Bundle{}, fmt.Errorf("decode stored resource: %w", err)
		}
		if decoded == nil {
			return internal.Bundle{}, fmt.Errorf("stored resource is null")
		}
		if err := decoder.Decode(new(any)); err != io.EOF {
			return internal.Bundle{}, fmt.Errorf("stored resource contains trailing data")
		}
		if !internal.ValidID(decoded.ID) {
			return internal.Bundle{}, fmt.Errorf("invalid stored resource id")
		}
		if err := decoded.Validate(); err != nil {
			return internal.Bundle{}, fmt.Errorf("invalid stored resource: %v", err)
		}
		bundle.Entry = append(bundle.Entry, internal.BundleEntry{Resource: *decoded})
	}
	return bundle, nil

}

func (s *ObservationService) GetObservationByID(ctx context.Context, id string) (internal.Observation, error) {
	if !internal.ValidID(id) {
		return internal.Observation{}, internal.Invalid("invalid observation id")
	}
	data, err := s.repo.GetObservationByID(ctx, id)
	if err != nil {
		return internal.Observation{}, err
	}

	// Decode the concrete Observation here; no decodeStored[T] helper.
	var decoded *internal.Observation
	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(&decoded); err != nil {
		return internal.Observation{}, fmt.Errorf("decode stored resource: %w", err)
	}
	if decoded == nil {
		return internal.Observation{}, fmt.Errorf("stored resource is null")
	}
	if err := decoder.Decode(new(any)); err != io.EOF {
		return internal.Observation{}, fmt.Errorf("stored resource contains trailing data")
	}
	if !internal.ValidID(decoded.ID) || decoded.ID != id {
		return internal.Observation{}, fmt.Errorf("stored resource id is missing, invalid, or mismatched")
	}
	if err := decoded.Validate(); err != nil {
		return internal.Observation{}, fmt.Errorf("invalid stored resource: %v", err)
	}
	return *decoded, nil

}

func (s *ObservationService) UpdateObservation(ctx context.Context, id string, resource internal.Observation, expectedVersion string) (internal.Observation, error) {
	if !internal.ValidID(id) || resource.ID != id {
		return internal.Observation{}, internal.Invalid("body id must match the resource id")
	}

	current, err := s.GetObservationByID(ctx, id)
	if err != nil {
		return internal.Observation{}, err
	}
	if expectedVersion != "" && expectedVersion != current.Meta.VersionID {
		return internal.Observation{}, internal.ErrPrecondition
	}

	// Explicit update steps, intentionally repeated in PUT and PATCH.
	if resource.ID != current.ID {
		return internal.Observation{}, internal.Invalid("resource id cannot change")
	}
	if resource.Subject.Reference != current.Subject.Reference {
		return internal.Observation{}, internal.Invalid("subject.reference cannot change on an existing Observation")
	}
	if err := resource.Validate(); err != nil {
		return internal.Observation{}, err
	}
	n := 0
	if current.Meta.VersionID != "" {
		var err error
		n, err = strconv.Atoi(current.Meta.VersionID)
		if err != nil || n < 1 || n == int(^uint(0)>>1) {
			return internal.Observation{}, fmt.Errorf("invalid stored resource version")
		}
	}
	resource.Meta = internal.Meta{VersionID: strconv.Itoa(n + 1), LastUpdated: time.Now().UTC().Format(time.RFC3339Nano)}
	replacementJSON, marshalErr := json.Marshal(resource)
	if marshalErr != nil {
		return internal.Observation{}, marshalErr
	}
	if err := s.repo.UpdateObservation(ctx, resource, replacementJSON, current.Meta.VersionID); err != nil {
		return internal.Observation{}, err
	}
	return resource, nil

}

func (s *ObservationService) PatchObservation(ctx context.Context, id string, patchData []byte, expectedVersion string) (internal.Observation, error) {
	patch, err := jsonpatch.DecodePatch(patchData)
	if err != nil || bytes.Equal(bytes.TrimSpace(patchData), []byte("null")) {
		return internal.Observation{}, internal.Invalid("invalid JSON Patch document")
	}
	current, err := s.GetObservationByID(ctx, id)
	if err != nil {
		return internal.Observation{}, err
	}
	if expectedVersion != "" && expectedVersion != current.Meta.VersionID {
		return internal.Observation{}, internal.ErrPrecondition
	}
	document, err := json.Marshal(current)
	if err != nil {
		return internal.Observation{}, err
	}
	options := jsonpatch.NewApplyOptions()
	options.SupportNegativeIndices = false
	options.AccumulatedCopySizeLimit = 1 << 20
	patched, err := patch.ApplyWithOptions(document, options)
	if err != nil || len(patched) > 1<<20 {
		return internal.Observation{}, internal.Invalid("patch failed or resource exceeds 1 MiB")
	}
	var resource internal.Observation
	decoder := json.NewDecoder(bytes.NewReader(patched))
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(&resource); err != nil {
		return internal.Observation{}, internal.Invalid("patch produced an unsupported resource: %v", err)
	}

	// Explicit update steps, intentionally repeated in PUT and PATCH.
	if resource.ID != current.ID {
		return internal.Observation{}, internal.Invalid("resource id cannot change")
	}
	if resource.Subject.Reference != current.Subject.Reference {
		return internal.Observation{}, internal.Invalid("subject.reference cannot change on an existing Observation")
	}
	if err := resource.Validate(); err != nil {
		return internal.Observation{}, err
	}
	n := 0
	if current.Meta.VersionID != "" {
		var err error
		n, err = strconv.Atoi(current.Meta.VersionID)
		if err != nil || n < 1 || n == int(^uint(0)>>1) {
			return internal.Observation{}, fmt.Errorf("invalid stored resource version")
		}
	}
	resource.Meta = internal.Meta{VersionID: strconv.Itoa(n + 1), LastUpdated: time.Now().UTC().Format(time.RFC3339Nano)}
	replacementJSON, marshalErr := json.Marshal(resource)
	if marshalErr != nil {
		return internal.Observation{}, marshalErr
	}
	if err := s.repo.UpdateObservation(ctx, resource, replacementJSON, current.Meta.VersionID); err != nil {
		return internal.Observation{}, err
	}
	return resource, nil

}

func (s *ObservationService) DeleteObservation(ctx context.Context, id, version string) error {
	if !internal.ValidID(id) {
		return internal.Invalid("invalid resource id")
	}
	return s.repo.DeleteObservation(ctx, id, version)
}

func (s *ObservationService) GetObservationHistory(ctx context.Context, id string) (internal.Bundle, error) {
	if !internal.ValidID(id) {
		return internal.Bundle{}, internal.Invalid("invalid resource id")
	}
	versions, err := s.repo.GetObservationHistory(ctx, id)
	if err != nil {
		return internal.Bundle{}, err
	}

	total := len(versions)
	bundle := internal.Bundle{ResourceType: "Bundle", Type: "history", Total: &total}
	for _, version := range versions {
		entry := internal.BundleEntry{
			Request:  &internal.BundleRequest{Method: version.Method, URL: "Observation/" + id},
			Response: &internal.BundleResponse{Status: "200", ETag: "W/\"" + version.VersionID + "\"", LastModified: version.RecordedAt.UTC().Format(time.RFC3339Nano)},
		}
		if version.Method == "POST" {
			entry.Request.URL = "Observation"
			entry.Response.Status = "201"
		}
		if version.Method == "DELETE" {
			entry.Response.Status = "204"
		} else {
			resource, meta, err := observationVersionResource(version, id)
			if err != nil {
				return internal.Bundle{}, err
			}
			entry.Resource = resource
			entry.Response.LastModified = meta.LastUpdated
		}
		bundle.Entry = append(bundle.Entry, entry)
	}
	return bundle, nil
}

func (s *ObservationService) GetObservationVersion(ctx context.Context, id, version string) (json.RawMessage, internal.Meta, error) {
	if !internal.ValidID(id) || !internal.ValidID(version) {
		return nil, internal.Meta{}, internal.Invalid("invalid resource id or version")
	}
	entry, err := s.repo.GetObservationVersion(ctx, id, version)
	if err != nil {
		return nil, internal.Meta{}, err
	}
	if entry.Method == "DELETE" {
		return nil, internal.Meta{}, internal.ErrGone
	}
	return observationVersionResource(entry, id)
}

// This concrete formatter is deliberately repeated in each resource's file.
// It preserves unknown historical JSON properties and exact numeric values.
func observationVersionResource(version repository.ResourceVersion, id string) (json.RawMessage, internal.Meta, error) {
	var document map[string]json.RawMessage
	if err := json.Unmarshal(version.Data, &document); err != nil {
		return nil, internal.Meta{}, err
	}
	if document == nil {
		return nil, internal.Meta{}, fmt.Errorf("stored resource version is null")
	}
	var header struct {
		ID           string
		ResourceType string
	}
	if err := json.Unmarshal(version.Data, &header); err != nil {
		return nil, internal.Meta{}, err
	}
	if header.ID != id || header.ResourceType != "Observation" {
		return nil, internal.Meta{}, fmt.Errorf("stored resource version has invalid identity")
	}
	var metadata map[string]json.RawMessage
	if raw, ok := document["meta"]; ok {
		if err := json.Unmarshal(raw, &metadata); err != nil {
			return nil, internal.Meta{}, err
		}
	}
	if metadata == nil {
		metadata = make(map[string]json.RawMessage)
	}
	meta := internal.Meta{VersionID: version.VersionID}
	if raw, ok := metadata["lastUpdated"]; ok {
		if err := json.Unmarshal(raw, &meta.LastUpdated); err != nil {
			return nil, internal.Meta{}, err
		}
	}
	if meta.LastUpdated == "" {
		meta.LastUpdated = version.RecordedAt.UTC().Format(time.RFC3339Nano)
	}
	metadata["versionId"], _ = json.Marshal(meta.VersionID)
	metadata["lastUpdated"], _ = json.Marshal(meta.LastUpdated)
	document["meta"], _ = json.Marshal(metadata)
	data, err := json.Marshal(document)
	return data, meta, err
}
