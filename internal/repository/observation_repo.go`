// The resource-specific transaction step is intentionally repeated per type.
// Patient deletion calls it in the Patient's transaction, preserving atomic cascade.
func deleteObservationTx(ctx context.Context, tx pgx.Tx, id, expectedVersion string, at time.Time) error {

	var data []byte
	var deleted bool
	if err := tx.QueryRow(ctx, `SELECT data, deleted_at IS NOT NULL FROM observations WHERE id = $1 FOR UPDATE`, id).Scan(&data, &deleted); err != nil { // Translate the database error here instead of calling a shared mapper.
		if errors.Is(err, pgx.ErrNoRows) {
			return internal.ErrNotFound
		}
		var postgresError9 *pgconn.PgError
		if errors.As(err, &postgresError9) && postgresError9.Code == "23505" {
			return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
		}
		return err
	}
	if deleted {
		return nil
	}
	var header struct{ Meta internal.Meta }
	if err := json.Unmarshal(data, &header); err != nil {
		return err
	}
	if expectedVersion != "" && expectedVersion != header.Meta.VersionID {
		return internal.ErrPrecondition
	}
	n := 0
	if header.Meta.VersionID != "" {
		var err error
		n, err = strconv.Atoi(header.Meta.VersionID)
		if err != nil || n < 1 || n == int(^uint(0)>>1) {
			return fmt.Errorf("invalid stored resource version")
		}
	}
	// Explicit snapshot, timestamp update, and deletion marker.
	if _, err := tx.Exec(ctx, `INSERT INTO observation_history (resource_id, version_id, data, method)
 SELECT id, COALESCE(NULLIF(data->'meta'->>'versionId', ''), 'legacy'), data, 'PUT'
 FROM observations WHERE id = $1 ON CONFLICT (resource_id, version_id) DO NOTHING`, id); err != nil {
		return err
	}
	if _, err := tx.Exec(ctx, `UPDATE observations SET deleted_at=$2 WHERE id=$1`, id, at); err != nil {
		return err
	}
	_, err := tx.Exec(ctx, `INSERT INTO observation_history (resource_id,version_id,method,recorded_at) VALUES ($1,$2,'DELETE',$3)`, id, strconv.Itoa(n+1), at)
	// Translate the database error here instead of calling a shared mapper.
	if errors.Is(err, pgx.ErrNoRows) {
		return internal.ErrNotFound
	}
	var postgresError10 *pgconn.PgError
	if errors.As(err, &postgresError10) && postgresError10.Code == "23505" {
		return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
	}
	return err

}

func (r *ObservationRepository) GetObservationHistory(ctx context.Context, id string) ([]ResourceVersion, error) {
	var exists bool
	if err := r.pool.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM observations WHERE id = $1)`, id).Scan(&exists); err != nil {
		return nil, err
	}
	if !exists {
		return nil, internal.ErrNotFound
	}
	rows, err := r.pool.Query(ctx, `SELECT version_id, data, method, recorded_at FROM observation_history WHERE resource_id = $1 ORDER BY sequence DESC`, id)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	var versions []ResourceVersion
	for rows.Next() {
		var version ResourceVersion
		if err := rows.Scan(&version.VersionID, &version.Data, &version.Method, &version.RecordedAt); err != nil {
			return nil, err
		}
		versions = append(versions, version)
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	return versions, nil
}

func (r *ObservationRepository) GetObservationVersion(ctx context.Context, id, version string) (ResourceVersion, error) {
	var entry ResourceVersion
	err := r.pool.QueryRow(ctx, `SELECT version_id, data, method, recorded_at FROM observation_history WHERE resource_id = $1 AND version_id = $2`, id, version).Scan(&entry.VersionID, &entry.Data, &entry.Method, &entry.RecordedAt)
	// Translate the database error here instead of calling a shared mapper.
	if errors.Is(err, pgx.ErrNoRows) {
		return entry, internal.ErrNotFound
	}
	var postgresError11 *pgconn.PgError
	if errors.As(err, &postgresError11) && postgresError11.Code == "23505" {
		return entry, fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
	}
	return entry, err
}
