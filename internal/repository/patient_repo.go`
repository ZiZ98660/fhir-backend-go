	tx, err := r.pool.Begin(ctx)
	if err != nil {
		return err
	}
	defer tx.Rollback(ctx)

	var oldData []byte
	var deleted bool
	if err := tx.QueryRow(ctx, `SELECT data,deleted_at IS NOT NULL FROM patients WHERE id=$1 FOR UPDATE`, p.ID).Scan(&oldData, &deleted); err != nil { // Translate the database error here instead of calling a shared mapper.
		if errors.Is(err, pgx.ErrNoRows) {
			return internal.ErrNotFound
		}
		var postgresError2 *pgconn.PgError
		if errors.As(err, &postgresError2) && postgresError2.Code == "23505" {
			return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
		}
		return err
	}
	if deleted {
		return internal.ErrGone
	}
	var current struct {
		Meta    internal.Meta
		Subject internal.Reference
	}
	if err := json.Unmarshal(oldData, &current); err != nil {
		return err
	}

	if current.Meta.VersionID != previousVersion {
		return internal.ErrPrecondition
	}
	id := p.ID
	if _, err := tx.Exec(ctx, `INSERT INTO patient_history (patient_id, version_id, data, method)
 SELECT id, COALESCE(NULLIF(data->'meta'->>'versionId', ''), 'legacy'), data, 'PUT'
 FROM patients WHERE id = $1 ON CONFLICT (patient_id, version_id) DO NOTHING`, id); err != nil {
		return err
	}
	result, err := tx.Exec(ctx, `UPDATE patients SET resource_type=$2,data=$3
 WHERE id=$1 AND deleted_at IS NULL AND COALESCE(data->'meta'->>'versionId','')=$4`, id, p.ResourceType, data, previousVersion)
	if err != nil { // Translate the database error here instead of calling a shared mapper.
		var postgresError3 *pgconn.PgError
		if errors.As(err, &postgresError3) && postgresError3.Code == "23505" {
			return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
		}
		return err
	}
	if result.RowsAffected() == 0 {
		return internal.ErrPrecondition
	}
	if _, err := tx.Exec(ctx, `INSERT INTO patient_history (patient_id,version_id,data,method) VALUES ($1,$2,$3,'PUT')`, id, p.Meta.VersionID, data); err != nil { // Translate the database error here instead of calling a shared mapper.
		var postgresError4 *pgconn.PgError
		if errors.As(err, &postgresError4) && postgresError4.Code == "23505" {
			return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
		}
		return err
	}
	return tx.Commit(ctx)
}

func (r *PatientRepository) SearchPatients(ctx context.Context, identifier string, searchTerm string) ([][]byte, error) {
	var rows pgx.Rows
	var err error

	if identifier != "" && searchTerm != "" {
		query := `SELECT data FROM patients WHERE deleted_at IS NULL AND data @> jsonb_build_object('identifier', jsonb_build_array(jsonb_build_object('value', $1::text))) AND data::text ILIKE $2 ORDER BY id`
		rows, err = r.pool.Query(ctx, query, identifier, "%"+searchTerm+"%")
	} else if identifier != "" {
		query := `SELECT data FROM patients WHERE deleted_at IS NULL AND data @> jsonb_build_object('identifier', jsonb_build_array(jsonb_build_object('value', $1::text)))`
		rows, err = r.pool.Query(ctx, query, identifier)
	} else if searchTerm != "" {
		query := `SELECT data FROM patients WHERE deleted_at IS NULL AND data::text ILIKE $1`
		rows, err = r.pool.Query(ctx, query, "%"+searchTerm+"%")
	} else {
		rows, err = r.pool.Query(ctx, "SELECT data FROM patients WHERE deleted_at IS NULL")
	}

	if err != nil {
		return nil, err
	}
	// The explicit loop replaces pgx.CollectRows and preserves both error checks.
	defer rows.Close()
	var results [][]byte
	for rows.Next() {
		var data []byte
		if err := rows.Scan(&data); err != nil {
			return nil, err
		}
		results = append(results, data)
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	return results, nil
}

