func (r *PatientRepository) DeletePatient(ctx context.Context, id, expectedVersion string) error {
	tx, err := r.pool.Begin(ctx)
	if err != nil {
		return err
	}
	defer tx.Rollback(ctx)

	var oldData []byte
	var alreadyDeleted bool
	if err := tx.QueryRow(ctx, `SELECT data,deleted_at IS NOT NULL FROM patients WHERE id=$1 FOR UPDATE`, id).Scan(&oldData, &alreadyDeleted); err != nil { // Translate the database error here instead of calling a shared mapper.
		if errors.Is(err, pgx.ErrNoRows) {
			return internal.ErrNotFound
		}
		var postgresError6 *pgconn.PgError
		if errors.As(err, &postgresError6) && postgresError6.Code == "23505" {
			return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
		}
		return err
	}
	if alreadyDeleted {
		return nil
	}
	var patientHeader struct{ Meta internal.Meta }
	if err := json.Unmarshal(oldData, &patientHeader); err != nil {
		return err
	}
	if expectedVersion != "" && expectedVersion != patientHeader.Meta.VersionID {
		return internal.ErrPrecondition
	}
	deletedAt := time.Now().UTC()
	rows, err := tx.Query(ctx, `SELECT id FROM observations WHERE patient_id = $1 AND deleted_at IS NULL ORDER BY id`, id)
	if err != nil {
		return err
	}
	var observationIDs []string
	for rows.Next() {
		var childID string
		if err := rows.Scan(&childID); err != nil {
			rows.Close()
			return err
		}
		observationIDs = append(observationIDs, childID)
	}
	rows.Close()
	if err := rows.Err(); err != nil {
		return err
	}
	// Delete each Observation inside this same transaction. Each child gets its
	// own snapshot and DELETE history entry before its deleted_at timestamp is set.
	for _, childID := range observationIDs {
		var childData []byte
		var childDeleted bool
		if err := tx.QueryRow(ctx, `SELECT data, deleted_at IS NOT NULL FROM observations WHERE id=$1 FOR UPDATE`, childID).Scan(&childData, &childDeleted); err != nil {
			return err
		}
		if childDeleted {
			continue
		}
		var childHeader struct{ Meta internal.Meta }
		if err := json.Unmarshal(childData, &childHeader); err != nil {
			return err
		}
		childVersion := 0
		if childHeader.Meta.VersionID != "" {
			childVersion, err = strconv.Atoi(childHeader.Meta.VersionID)
			if err != nil || childVersion < 1 || childVersion == int(^uint(0)>>1) {
				return fmt.Errorf("invalid stored observation version")
			}
		}
		if _, err := tx.Exec(ctx, `INSERT INTO observation_history (resource_id,version_id,data,method)
			SELECT id, COALESCE(NULLIF(data->'meta'->>'versionId',''),'legacy'), data, 'PUT'
			FROM observations WHERE id=$1 ON CONFLICT (resource_id,version_id) DO NOTHING`, childID); err != nil {
			return err
		}
		if _, err := tx.Exec(ctx, `UPDATE observations SET deleted_at=$2 WHERE id=$1`, childID, deletedAt); err != nil {
			return err
		}
		if _, err := tx.Exec(ctx, `INSERT INTO observation_history (resource_id,version_id,method,recorded_at)
			VALUES ($1,$2,'DELETE',$3)`, childID, strconv.Itoa(childVersion+1), deletedAt); err != nil {
			return err
		}
	}
	rows, err = tx.Query(ctx, `SELECT id FROM conditions WHERE data->'subject'->>'reference' = $1 AND deleted_at IS NULL ORDER BY id`, "Patient/"+id)
	if err != nil {
		return err
	}
	var conditionIDs []string
	for rows.Next() {
		var childID string
		if err := rows.Scan(&childID); err != nil {
			rows.Close()
			return err
		}
		conditionIDs = append(conditionIDs, childID)
	}
	rows.Close()
	if err := rows.Err(); err != nil {
		return err
	}
	// Repeat the same explicit sequence for Conditions so the whole Patient
	// cascade either commits together or rolls back together.
	for _, childID := range conditionIDs {
		var childData []byte
		var childDeleted bool
		if err := tx.QueryRow(ctx, `SELECT data, deleted_at IS NOT NULL FROM conditions WHERE id=$1 FOR UPDATE`, childID).Scan(&childData, &childDeleted); err != nil {
			return err
		}
		if childDeleted {
			continue
		}
		var childHeader struct{ Meta internal.Meta }
		if err := json.Unmarshal(childData, &childHeader); err != nil {
			return err
		}
		childVersion := 0
		if childHeader.Meta.VersionID != "" {
			childVersion, err = strconv.Atoi(childHeader.Meta.VersionID)
			if err != nil || childVersion < 1 || childVersion == int(^uint(0)>>1) {
				return fmt.Errorf("invalid stored condition version")
			}
		}
		if _, err := tx.Exec(ctx, `INSERT INTO condition_history (resource_id,version_id,data,method)
			SELECT id, COALESCE(NULLIF(data->'meta'->>'versionId',''),'legacy'), data, 'PUT'
			FROM conditions WHERE id=$1 ON CONFLICT (resource_id,version_id) DO NOTHING`, childID); err != nil {
			return err
		}
		if _, err := tx.Exec(ctx, `UPDATE conditions SET deleted_at=$2 WHERE id=$1`, childID, deletedAt); err != nil {
			return err
		}
		if _, err := tx.Exec(ctx, `INSERT INTO condition_history (resource_id,version_id,method,recorded_at)
			VALUES ($1,$2,'DELETE',$3)`, childID, strconv.Itoa(childVersion+1), deletedAt); err != nil {
			return err
		}
	}

	n := 0
	if patientHeader.Meta.VersionID != "" {
		var err error
		n, err = strconv.Atoi(patientHeader.Meta.VersionID)
		if err != nil || n < 1 || n == int(^uint(0)>>1) {
			return fmt.Errorf("invalid stored resource version")
		}
	}
	if _, err := tx.Exec(ctx, `INSERT INTO patient_history (patient_id, version_id, data, method)
 SELECT id, COALESCE(NULLIF(data->'meta'->>'versionId', ''), 'legacy'), data, 'PUT'
 FROM patients WHERE id = $1 ON CONFLICT (patient_id, version_id) DO NOTHING`, id); err != nil {
		return err
	}
	if _, err := tx.Exec(ctx, `UPDATE patients SET deleted_at=$2 WHERE id=$1`, id, deletedAt); err != nil {
		return err
	}
	if _, err := tx.Exec(ctx, `INSERT INTO patient_history(patient_id,version_id,method,recorded_at) VALUES($1,$2,'DELETE',$3)`, id, strconv.Itoa(n+1), deletedAt); err != nil { // Translate the database error here instead of calling a shared mapper.
		var postgresError7 *pgconn.PgError
		if errors.As(err, &postgresError7) && postgresError7.Code == "23505" {
			return fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
		}
		return err
	}

	return tx.Commit(ctx)
}

func (r *PatientRepository) GetPatientHistory(ctx context.Context, id string) ([]ResourceVersion, error) {
	var exists bool
	if err := r.pool.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM patients WHERE id = $1)`, id).Scan(&exists); err != nil {
		return nil, err
	}
	if !exists {
		return nil, internal.ErrNotFound
	}
	rows, err := r.pool.Query(ctx, `SELECT version_id, data, method, recorded_at FROM patient_history WHERE patient_id = $1 ORDER BY sequence DESC`, id)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	var versions []ResourceVersion
	for rows.Next() {
		var version ResourceVersion
		if err := rows.Scan(&version.VersionID, &version.Data, &version.Method, &version.RecordedAt); err != nil {
			return nil, err
		}
		versions = append(versions, version)
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	return versions, nil
}

func (r *PatientRepository) GetPatientVersion(ctx context.Context, id, version string) (ResourceVersion, error) {
	var entry ResourceVersion
	err := r.pool.QueryRow(ctx, `SELECT version_id, data, method, recorded_at FROM patient_history WHERE patient_id = $1 AND version_id = $2`, id, version).Scan(&entry.VersionID, &entry.Data, &entry.Method, &entry.RecordedAt)
	// Translate the database error here instead of calling a shared mapper.
	if errors.Is(err, pgx.ErrNoRows) {
		return entry, internal.ErrNotFound
	}
	var postgresError8 *pgconn.PgError
	if errors.As(err, &postgresError8) && postgresError8.Code == "23505" {
		return entry, fmt.Errorf("%w: resource id already exists", internal.ErrConflict)
	}
	return entry, err
}
